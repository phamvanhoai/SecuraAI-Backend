generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ai_datasets {
  id                       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String              @db.VarChar(255)
  version                  String              @db.VarChar(100)
  source                   String
  license_or_usage_rights  String?
  ground_truth_description String?
  privacy_notes            String?
  limitations              String?
  train_split              Decimal?            @db.Decimal(5, 2)
  validation_split         Decimal?            @db.Decimal(5, 2)
  test_split               Decimal?            @db.Decimal(5, 2)
  created_at               DateTime            @default(now()) @db.Timestamptz(6)
  ai_model_versions        ai_model_versions[]

  @@unique([name, version], map: "uq_ai_dataset")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ai_model_evaluations {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  model_version_id     String            @db.Uuid
  precision            Decimal?          @db.Decimal(8, 6)
  recall               Decimal?          @db.Decimal(8, 6)
  f1_score             Decimal?          @db.Decimal(8, 6)
  pr_auc               Decimal?          @db.Decimal(8, 6)
  false_positive_rate  Decimal?          @db.Decimal(8, 6)
  alerts_per_day       Decimal?          @db.Decimal(12, 2)
  detection_latency_ms Decimal?          @db.Decimal(12, 2)
  evaluation_notes     String?
  evaluated_at         DateTime          @default(now()) @db.Timestamptz(6)
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  ai_model_versions    ai_model_versions @relation(fields: [model_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_model_evaluation_version")

  @@index([model_version_id, evaluated_at(sort: Desc)], map: "idx_ai_evaluations_model")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ai_model_versions {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  model_name           String                 @db.VarChar(255)
  model_type           String                 @db.VarChar(100)
  version              String                 @db.VarChar(100)
  dataset_id           String?                @db.Uuid
  feature_definition   Json?
  parameters           Json?
  status               model_status           @default(DEVELOPMENT)
  deployed_at          DateTime?              @db.Timestamptz(6)
  retired_at           DateTime?              @db.Timestamptz(6)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  ai_model_evaluations ai_model_evaluations[]
  ai_datasets          ai_datasets?           @relation(fields: [dataset_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_model_dataset")
  alert_triage_records alert_triage_records[]
  anomaly_detections   anomaly_detections[]

  @@unique([model_name, version], map: "uq_ai_model_version")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model alert_triage_records {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alert_id          String              @db.Uuid
  analyst_user_id   String              @db.Uuid
  decision          triage_decision
  reason            String
  model_version_id  String              @db.Uuid
  started_at        DateTime?           @db.Timestamptz(6)
  completed_at      DateTime?           @db.Timestamptz(6)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  anomaly_alerts    anomaly_alerts      @relation(fields: [alert_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_triage_alert")
  users             users               @relation(fields: [analyst_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_triage_analyst")
  ai_model_versions ai_model_versions   @relation(fields: [model_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_triage_model")
  security_findings security_findings[]

  @@index([alert_id, created_at(sort: Desc)], map: "idx_triage_alert")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model anomaly_alerts {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  detection_id         String                 @unique @db.Uuid
  severity             String?                @db.VarChar(50)
  status               alert_status           @default(NEW)
  assigned_to          String?                @db.Uuid
  generated_at         DateTime               @default(now()) @db.Timestamptz(6)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  alert_triage_records alert_triage_records[]
  users                users?                 @relation(fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_alert_assigned_to")
  anomaly_detections   anomaly_detections     @relation(fields: [detection_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_alert_detection")
  security_findings    security_findings?

  @@index([status, generated_at(sort: Desc)], map: "idx_anomaly_alerts_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model anomaly_detections {
  id                            String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id                      String                          @db.Uuid
  model_version_id              String                          @db.Uuid
  anomaly_score                 Decimal                         @db.Decimal(10, 8)
  threshold                     Decimal                         @db.Decimal(10, 8)
  is_anomaly                    Boolean
  detected_at                   DateTime                        @default(now()) @db.Timestamptz(6)
  created_at                    DateTime                        @default(now()) @db.Timestamptz(6)
  anomaly_alerts                anomaly_alerts?
  normalized_events             normalized_events               @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_detection_event")
  ai_model_versions             ai_model_versions               @relation(fields: [model_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_detection_model")
  anomaly_feature_contributions anomaly_feature_contributions[]

  @@unique([event_id, model_version_id], map: "uq_anomaly_detection_event_model")
  @@index([event_id], map: "idx_anomaly_detections_event")
  @@index([model_version_id], map: "idx_anomaly_detections_model")
  @@index([detected_at(sort: Desc)], map: "idx_anomaly_detections_time")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
