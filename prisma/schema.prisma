}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model ai_alert_explanations {
  ai_alert_explanation_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ai_alert_id             String    @db.Uuid
  explanation_text        String
  feature_contributions   Json?
  baseline_data           Json?
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  ai_alerts               ai_alerts @relation(fields: [ai_alert_id], references: [ai_alert_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model ai_alerts {
  ai_alert_id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alert_code            String                  @unique @db.VarChar(50)
  security_event_id     String                  @db.Uuid
  log_source_id         String                  @db.Uuid
  asset_id              String?                 @db.Uuid
  ai_model_version_id   String                  @db.Uuid
  anomaly_score         Decimal                 @db.Decimal(8, 6)
  risk_score            Decimal?                @db.Decimal(8, 4)
  risk_level            String?                 @db.VarChar(20)
  title                 String                  @db.VarChar(255)
  description           String?
  status                String                  @default("new") @db.VarChar(30)
  detected_at           DateTime                @default(now()) @db.Timestamptz(6)
  reviewed_by_user_id   String?                 @db.Uuid
  reviewed_at           DateTime?               @db.Timestamptz(6)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  ai_alert_explanations ai_alert_explanations[]
  ai_model_versions     ai_model_versions       @relation(fields: [ai_model_version_id], references: [ai_model_version_id], onDelete: NoAction, onUpdate: NoAction)
  assets                assets?                 @relation(fields: [asset_id], references: [asset_id], onDelete: NoAction, onUpdate: NoAction)
  log_sources           log_sources             @relation(fields: [log_source_id], references: [log_source_id], onDelete: NoAction, onUpdate: NoAction)
  users                 users?                  @relation(fields: [reviewed_by_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  security_events       security_events         @relation(fields: [security_event_id], references: [security_event_id], onDelete: NoAction, onUpdate: NoAction)
  ai_feedback           ai_feedback[]
  incident_alert_links  incident_alert_links[]

  @@index([ai_model_version_id])
  @@index([asset_id])
  @@index([log_source_id])
  @@index([security_event_id])
  @@index([status, detected_at])
}

