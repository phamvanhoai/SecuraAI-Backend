NODE_ENV=development
API_RATE_LIMIT=300
AUTH_CREDENTIAL_RATE_LIMIT=10
AUTH_SESSION_RATE_LIMIT=120
PORT=3000
API_PREFIX=/api/v1
DATABASE_URL=postgresql://securaai:change_me@localhost:5432/securaai?schema=public
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=info
TRUST_PROXY=false
SWAGGER_ENABLED=true
APP_NAME=SecuraAI
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hf.co/fdtn-ai/Foundation-Sec-1.1-8B-Instruct-Q4_K_M-GGUF
OLLAMA_TIMEOUT_MS=60000
ANOMALY_AUTO_DETECTION_ENABLED=true
ANOMALY_AUTO_DETECTION_INTERVAL_MS=60000
# Automated event retention purge worker (defaults: enabled, hourly interval, 200 rows/batch, max 50 batches/run)
RETENTION_PURGE_ENABLED=true
RETENTION_PURGE_INTERVAL_MS=3600000
RETENTION_PURGE_BATCH_SIZE=200
RETENTION_PURGE_MAX_BATCHES_PER_RUN=50
RETENTION_PURGE_RUN_ON_STARTUP=false
WAZUH_INGEST_TOKEN=
GOOGLE_CLIENT_ID=

# Required only when deliberately running npm run db:seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=System Administrator

# Optional idempotent demo data for the V2 risk register.
SEED_RISK_DEMO=false

# Apply durable_detection_jobs migration; run npm run worker separately when enabled.
DETECTION_PIPELINE_ENABLED=false

# Required ML triage and LLM final-review pipeline.
ML_MODEL_BASE_URL=http://127.0.0.1:8000
ML_MODEL_TIMEOUT_MS=2000
