NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
DATABASE_URL=postgresql://securaai:change_me@localhost:5432/securaai?schema=public
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=info
TRUST_PROXY=false
SWAGGER_ENABLED=true
APP_NAME=SecuraAI
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hf.co/fdtn-ai/Foundation-Sec-1.1-8B-Instruct-Q4_K_M-GGUF
OLLAMA_TIMEOUT_MS=60000
ANOMALY_AUTO_DETECTION_ENABLED=true
ANOMALY_AUTO_DETECTION_INTERVAL_MS=60000
WAZUH_INGEST_TOKEN=
GOOGLE_CLIENT_ID=

# Required only when deliberately running npm run db:seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=System Administrator

# Optional idempotent demo data for the V2 risk register.
SEED_RISK_DEMO=false

# Apply durable_detection_jobs migration; run npm run worker separately when enabled.
DETECTION_PIPELINE_ENABLED=false

# Experimental ML + LLM fusion. The initial 70/30 weights require validation before production use.
ML_SHADOW_ENABLED=false
ML_SHADOW_BASE_URL=http://127.0.0.1:8000
ML_SHADOW_TIMEOUT_MS=2000
AI_FUSION_ENABLED=false
LLM_CLASSIFIER_ENABLED=false
AI_FUSION_CAN_CREATE_ALERTS=true
