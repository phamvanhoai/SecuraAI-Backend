NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
DATABASE_URL=postgresql://securaai:change_me@localhost:5432/securaai?schema=public
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=info
TRUST_PROXY=false
SWAGGER_ENABLED=true
APP_NAME=SecuraAI
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=60000
WAZUH_INGEST_TOKEN=
GOOGLE_CLIENT_ID=

# Required only when deliberately running npm run db:seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=System Administrator

# Optional idempotent demo data for the V2 risk register.
SEED_RISK_DEMO=false
